# 복사해서 사용: cp .env.example .env   (.env 는 Git 에 올리지 않음)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=vision_action
POSTGRES_USER=vision_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
FASTAPI_URL=http://localhost:8001
FASTAPI_TIMEOUT_SEC=180

MAX_UPLOAD_MB=100
# 휴대폰 IP Webcam 앱 주소 (쉼표로 여러 개). 허용 목록에 있는 주소만 연결
ALLOWED_CAMERA_URLS=http://192.168.0.10:8080/video
CAMERA_CAPTURE_SECONDS=8
